# Runtime / per-machine files generated by the Memory Hive CLI.
# The source repo ships a template hive; live agent data and indexes are local.

# Indexes and caches
.hivecode/
*.sqlite
*.sqlite-journal
.bundle-cache/

# Runtime markers and temp files
.doctor-stale.*
.query-counts.*
.query-files.*
.last-maintained
.baseline-installed
.wired-platforms

# Per-user runtime content (agents, raw learnings, conversations, tasks, checkpoints)
# Note: tracked template files in these directories remain tracked; this only
# prevents new untracked runtime files from being accidentally staged.
hive/agents/*/
hive/learnings/raw/*/
hive/learnings/raw/
hive/conversations
hive/raw/
hive/tasks/
hive/checkpoints/
hive/.checkpoints/

# Merge/reconciliation artifacts produced by the CLI
*.local
*.upstream

# Auto-generated registry files
hive/registry/CITATIONS.md

# Vercel / Next.js site build artifacts (memory-hive-site)
.vercel/
.next/
out/
node_modules/

# macOS / editor noise
.DS_Store
*.swp
*.swo
*~

# Local backups
memory-hive-v2-release
